# Update-Iran-IP v2.4 (2026-10-10)
# Reads Iran-IP.txt and applies only the differences (new entries are added
# before old ones are removed), so the list never has a gap and almost
# nothing is written to flash. A failed or cut-off download
# leaves the list untouched. Entries whose comment starts with "keep" are
# never removed. For a trial run: ":global IranIPDryRun true" first.
# The list name variable must not be called "list": inside "find" that
# name means the entry's own list, so every address list would match.
:global IranIPDryRun
:local url "https://raw.githubusercontent.com/seventysevendanismanlik-create/mikrotik-scripts/main/address-lists/Iran-IP.txt"
:local listName "Iran-IP"
:local minEntries 1000
:local r
:local ok false
:local try 0
:while ((!$ok) && ($try < 6)) do={
  :set try ($try + 1)
  :do {
    :set r [/tool fetch url=$url output=user as-value]
    :set ok true
  } on-error={ :delay 15s }
}
:if (!$ok) do={
  :log error "Iran-IP Update: download failed 6 times, list unchanged"
  :error "Iran-IP Update: download failed"
}
:local d ($r->"data")
:if ([:typeof [:find $d "#END"]] != "num") do={
  :log error "Iran-IP Update: file incomplete, list unchanged"
  :error "Iran-IP Update: file incomplete"
}
:local want ({})
:local n 0
:local pos 0
:local len [:len $d]
:while ($pos < $len) do={
  :local e [:find $d "\n" ($pos - 1)]
  :if ([:typeof $e] != "num") do={ :set e $len }
  :local line [:pick $d $pos $e]
  :set pos ($e + 1)
  :if ([:len $line] > 0) do={
    :if ([:pick $line ([:len $line] - 1)] = "\r") do={ :set line [:pick $line 0 ([:len $line] - 1)] }
  }
  :if ([:len $line] > 6) do={
    :if ([:pick $line 0 1] != "#") do={ :set ($want->$line) 1; :set n ($n + 1) }
  }
}
:if ($n < $minEntries) do={
  :log error ("Iran-IP Update: only " . $n . " prefixes in file, list unchanged")
  :error "Iran-IP Update: too few prefixes"
}
:local added 0
:local removed 0
:local stale ({})
:foreach i in=[/ip firewall address-list find list=$listName] do={
  :if ([/ip firewall address-list get $i list] = $listName) do={
    :local a [/ip firewall address-list get $i address]
    :if ([:typeof ($want->$a)] != "num") do={
      :if ([:pick [/ip firewall address-list get $i comment] 0 4] != "keep") do={
        :set stale ($stale , $i)
        :set removed ($removed + 1)
      }
    } else={ :set ($want->$a) 0 }
  }
}
:foreach a,v in=$want do={
  :if ($v = 1) do={
    :if ($IranIPDryRun != true) do={ /ip firewall address-list add list=$listName address=$a comment="auto" }
    :set added ($added + 1)
  }
}
:if ($IranIPDryRun != true) do={
  :foreach i in=$stale do={ /ip firewall address-list remove $i }
}
:local mode ""
:if ($IranIPDryRun = true) do={ :set mode "DRY RUN " }
:log info ("Iran-IP Update: " . $mode . "+" . $added . " -" . $removed . ", " . $n . " prefixes in file, try " . $try)
