# Installs or updates the Update-Iran-IP script. On the router:
#   /tool fetch url="https://raw.githubusercontent.com/seventysevendanismanlik-create/mikrotik-scripts/main/routeros/install-Update-Iran-IP.rsc"
#   /import install-Update-Iran-IP.rsc
:if ([:len [/system script find name=Update-Iran-IP]] = 0) do={ /system script add name=Update-Iran-IP policy=ftp,read,write,policy,test source="" }
/system script set [find name=Update-Iran-IP] source="# Update-Iran-IP v2 (2026-10-10)\n# Reads Iran-IP.txt and applies only the differences, so the list is never\n# empty and almost nothing is written to flash. A failed or cut-off download\n# leaves the list untouched. Entries whose comment starts with \"keep\" are\n# never removed. For a trial run: \":global IranIPDryRun true\" first.\n:global IranIPDryRun\n:local url \"https://raw.githubusercontent.com/seventysevendanismanlik-create/mikrotik-scripts/main/address-lists/Iran-IP.txt\"\n:local list \"Iran-IP\"\n:local minEntries 1000\n:local r\n:do {\n  :set r [/tool fetch url=\$url output=user as-value]\n} on-error={\n  :log error \"Iran-IP Update: download failed, list unchanged\"\n  :error \"Iran-IP Update: download failed\"\n}\n:local d (\$r->\"data\")\n:if ([:typeof [:find \$d \"#END\"]] = \"nil\") do={\n  :log error \"Iran-IP Update: file incomplete, list unchanged\"\n  :error \"Iran-IP Update: file incomplete\"\n}\n:local want ({})\n:local n 0\n:local pos 0\n:local len [:len \$d]\n:while (\$pos < \$len) do={\n  :local e [:find \$d \"\\n\" (\$pos - 1)]\n  :if ([:typeof \$e] = \"nil\") do={ :set e \$len }\n  :local line [:pick \$d \$pos \$e]\n  :set pos (\$e + 1)\n  :if ([:len \$line] > 0) do={\n    :if ([:pick \$line ([:len \$line] - 1)] = \"\\r\") do={ :set line [:pick \$line 0 ([:len \$line] - 1)] }\n  }\n  :if ([:len \$line] > 6) do={\n    :if ([:pick \$line 0 1] != \"#\") do={ :set (\$want->\$line) 1; :set n (\$n + 1) }\n  }\n}\n:if (\$n < \$minEntries) do={\n  :log error (\"Iran-IP Update: only \" . \$n . \" prefixes in file, list unchanged\")\n  :error \"Iran-IP Update: too few prefixes\"\n}\n:local added 0\n:local removed 0\n:foreach i in=[/ip firewall address-list find list=\$list] do={\n  :local a [/ip firewall address-list get \$i address]\n  :if ([:typeof (\$want->\$a)] = \"nil\") do={\n    :if ([:pick [/ip firewall address-list get \$i comment] 0 4] != \"keep\") do={\n      :if (\$IranIPDryRun != true) do={ /ip firewall address-list remove \$i }\n      :set removed (\$removed + 1)\n    }\n  } else={ :set (\$want->\$a) 0 }\n}\n:foreach a,v in=\$want do={\n  :if (\$v = 1) do={\n    :if (\$IranIPDryRun != true) do={ /ip firewall address-list add list=\$list address=\$a comment=\"auto\" }\n    :set added (\$added + 1)\n  }\n}\n:local mode \"\"\n:if (\$IranIPDryRun = true) do={ :set mode \"DRY RUN \" }\n:log info (\"Iran-IP Update: \" . \$mode . \"+\" . \$added . \" -\" . \$removed . \", \" . \$n . \" prefixes in file\")"
:put "Update-Iran-IP installed"
